{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/i/:slug",
      "destination": "/api/invite-html?slug=:slug"
    },
    {
      "source": "/i/:slug/:path*",
      "destination": "/api/invite-html?slug=:slug"
    }
  ]
}
